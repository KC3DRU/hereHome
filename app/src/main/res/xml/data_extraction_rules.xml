<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup / device-transfer rules for Android 12+ (API 31+).
    Excludes the recipient-list preferences (here_settings) and all internal
    files from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="here_settings.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="here_settings.xml" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
